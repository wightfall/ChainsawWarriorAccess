<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>CWAccess-Setup</AssemblyName>
    <RootNamespace>CWAccess.Installer</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Product>Chainsaw Warrior Access Setup</Product>
    <Description>Installs and updates the Chainsaw Warrior Access screen reader mod</Description>
    <DefineConstants>$(DefineConstants);INSTALLER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared with the mod: the language file format. -->
    <Compile Include="..\CWAccess\Util\LanguageFile.cs" Link="LanguageFile.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Cecil is embedded in the exe: the game's CWAccess folder holds an older Cecil that Harmony needs. -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PkgMono_Cecil)/lib/net40/Mono.Cecil.dll" LogicalName="Mono.Cecil.dll" />
  </ItemGroup>
  <!-- The release package (without this exe) is embedded so the setup also works offline: -p:PayloadZip=path. -->
  <ItemGroup Condition="'$(PayloadZip)' != '' And Exists('$(PayloadZip)')">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
  </ItemGroup>
  <Target Name="NoCecilCopy" AfterTargets="Build">
    <Delete Files="$(TargetDir)Mono.Cecil.dll;$(TargetDir)Mono.Cecil.Mdb.dll;$(TargetDir)Mono.Cecil.Pdb.dll;$(TargetDir)Mono.Cecil.Rocks.dll" />
  </Target>
</Project>
