<Project>
  <PropertyGroup>
    <!-- Path to the Chainsaw Warrior install. Override with: dotnet build -p:GameDir="D:\Games\ChainsawWarrior" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\ChainsawWarrior</GameDir>
    <ManagedDir>$(GameDir)\CWSteamPC_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <Version>0.2.1</Version>
    <Authors>CWAccess contributors</Authors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
